{"pseudo": "", "scenes": [
 {"segs": [0], "text": "Your shoulders look *small* for one simple reason.", "img": "dos", "key": "WHY?", "keyAt": 0.6, "glow": [{"x": 0.36, "y": 0.33, "rx": 0.07, "ry": 0.05, "color": "red", "at": 0.5}, {"x": 0.63, "y": 0.33, "rx": 0.07, "ry": 0.05, "color": "red", "at": 0.5}]},
 {"segs": [1], "text": "You only train the *front.*", "img": "face", "key": "ONLY THE FRONT", "keyColor": "red", "keyAt": 0.4, "glow": [{"x": 0.38, "y": 0.27, "rx": 0.05, "ry": 0.05, "color": "red", "at": 0.3, "name": "Front", "side": "left"}, {"x": 0.62, "y": 0.27, "rx": 0.05, "ry": 0.05, "color": "red", "at": 0.3}]},
 {"segs": [2, 3], "text": "Most guys *bench press* all week… and still look *narrow.*", "img": "bench_2", "icon": "x", "iconAt": 0.75, "flash": "red"},
 {"segs": [4], "text": "Your shoulder has *three parts.*", "img": "face", "key": "3 PARTS", "keyColor": "gold", "keyAt": 0.5},
 {"segs": [5, 6], "text": "The *front…* the *side…* and the *rear.*", "img": "face", "glow": [{"x": 0.38, "y": 0.27, "rx": 0.05, "ry": 0.05, "color": "red", "at": 0.0, "name": "Front", "side": "left"}, {"x": 0.655, "y": 0.29, "rx": 0.05, "ry": 0.06, "color": "green", "at": 0.45, "name": "Side", "side": "right"}, {"x": 0.30, "y": 0.29, "rx": 0.04, "ry": 0.05, "color": "orange", "at": 0.8, "name": "Rear", "side": "left"}]},
 {"segs": [7], "text": "The *side delt* is what makes you look *wide.*", "img": "proud_1", "arrows": true, "arrowY": 0.27, "key": "WIDE", "keyColor": "gold", "keyAt": 0.6, "glow": [{"x": 0.31, "y": 0.27, "rx": 0.06, "ry": 0.06, "color": "green", "at": 0.1}, {"x": 0.69, "y": 0.27, "rx": 0.06, "ry": 0.06, "color": "green", "at": 0.1}]},
 {"segs": [8, 9], "text": "Number one. *Lateral raises.*", "loop": ["lat_down_1", "lat_up_1"], "period": 0.8, "label": "#1. Lateral Raise", "flash": "white"},
 {"segs": [10, 11], "text": "Lift to *shoulder height.* No *swinging.*", "loop": ["lat_down_1", "lat_up_1"], "period": 0.8, "label": "#1. Lateral Raise", "lineY": 0.27, "lineAt": 0.1, "icon": "x", "iconAt": 0.8},
 {"segs": [12], "text": "*Slow* on the way down.", "loop": ["lat_down_1", "lat_up_1"], "period": 1.4, "label": "#1. Lateral Raise", "key": "SLOW ↓", "keyAt": 0.2, "icon": "check", "iconAt": 0.7},
 {"segs": [13, 14], "text": "Number two. *Overhead press.*", "loop": ["ohp_down_1", "ohp_up_1"], "period": 0.8, "label": "#2. Overhead Press", "flash": "white"},
 {"segs": [15], "text": "Press *straight up,* and keep your *ribs down.*", "loop": ["ohp_down_1", "ohp_up_1"], "period": 0.8, "label": "#2. Overhead Press", "key": "RIBS DOWN", "keyAt": 0.55, "icon": "check", "iconAt": 0.85},
 {"segs": [16, 17], "text": "Number three. *Rear delt fly.*", "loop": ["rdf_up_1", "rdf_up_2"], "period": 0.9, "label": "#3. Rear Delt Fly", "flash": "white"},
 {"segs": [18, 19], "text": "Lean forward, *pull wide,* and *squeeze.*", "loop": ["rdf_up_1", "rdf_up_2"], "period": 0.9, "label": "#3. Rear Delt Fly", "key": "SQUEEZE", "keyAt": 0.75},
 {"segs": [20], "text": "Now, the *biggest mistake.*", "img": "heavy_2", "flash": "red", "key": "MISTAKE", "keyColor": "red", "keyAt": 0.4},
 {"segs": [21], "text": "Going *too heavy.*", "img": "heavy_2", "icon": "x", "iconAt": 0.4},
 {"segs": [22, 23], "text": "Light weight, slow reps, *full control.*", "loop": ["lat_down_1", "lat_up_1"], "period": 1.3, "icon": "check", "iconAt": 0.8},
 {"segs": [24], "text": "That's where the *growth* is.", "img": "proud_1", "key": "GROWTH", "keyColor": "green", "keyAt": 0.5, "glow": [{"x": 0.31, "y": 0.27, "rx": 0.06, "ry": 0.06, "color": "green", "at": 0.2}, {"x": 0.69, "y": 0.27, "rx": 0.06, "ry": 0.06, "color": "green", "at": 0.2}]},
 {"segs": [25], "text": "Do this *twice a week…*", "img": "face", "key": "2× / WEEK", "keyColor": "gold", "keyAt": 0.3},
 {"segs": [26, 27], "text": "and in a few months, *people will notice.*", "img": "proud_1", "zoom": 1.1, "arrows": true, "arrowY": 0.27},
