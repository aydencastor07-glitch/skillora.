# Copie ce fichier en `.env.local` pour brancher le vrai backend.
# Laisse vide = mode démo (données simulées, aucune API payante nécessaire).

# URL des Edge Functions Supabase, ex. https://<project-ref>.supabase.co/functions/v1
EXPO_PUBLIC_QUAX_API_URL=
# Clé "anon" publique du projet Supabase
EXPO_PUBLIC_QUAX_ANON_KEY=

# ⚠️ Les clés secrètes (Anthropic, Post for Me, SociaVault) ne vont JAMAIS ici :
# elles se configurent côté serveur avec `supabase secrets set` (voir README).
