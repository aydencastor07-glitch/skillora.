{
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!gesetze/|laws|_vercel/|api/).*)",
      "has": [
        {
          "type": "host",
          "value": "gesetze.skillora.me"
        }
      ],
      "destination": "/gesetze/",
      "permanent": false
    },
    {
      "source": "/gesetze",
      "destination": "/gesetze/",
      "permanent": true
    },
    {
      "source": "/laws",
      "destination": "/laws/",
      "permanent": true
    }
  ],
  "functions": {
    "api/download.js": {
      "includeFiles": "api/_livre/**"
    },
    "api/envoyer-livre.js": {
      "includeFiles": "api/_livre/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/whop-webhook",
      "destination": "/api/hook?src=whop"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/hook?src=stripe"
    },
    {
      "source": "/api/blower",
      "destination": "/api/hook?src=blower"
    },
    {
      "source": "/api/torch-stats",
      "destination": "/api/hook?src=stats"
    }
  ]
}
